[project]
title = dkc2-reforge

[bootstrap]
main_collection = /main/main.collectionc
render = /main/native.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1024
height = 896
high_dpi = 0
update_frequency = 60

[script]
shared_state = 1

[windows]
app_icon = /assets/app_icons/appicon.ico

[osx]
app_icon = /assets/app_icons/appicon.icns

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
velocity_threshold = 100.0

[html5]
scale_mode = stretch


[label]
max_count = 160

[sound]
max_component_count = 96
max_sound_buffers = 96
max_sound_data = 128

[sprite]
max_count = 1400
subpixels = 0

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[collection]
max_instances = 1600

[dkc2]
start_level = 
autopilot = 0
perf_log = 0
